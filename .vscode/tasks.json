{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "firmware_build",
            "type": "shell",
            // Directly flash here. See launch.json for more information.
            "command": "./run.py software --build && cd software/targets/rp2040 && cargo flash --chip rp2040",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$rustc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
        }
    ]
}
