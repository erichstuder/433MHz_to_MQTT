{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "probe-rs launch",
            "type": "probe-rs-debug",
            "request": "launch",
            "preLaunchTask": "firmware_build",
            "cwd": "${workspaceFolder}/software/targets/rp2040",
            "connectUnderReset": false,
            "chip": "RP2040",
            "flashingConfig": {
                // Due to a problem with probe-rs we flash in the preLaunchTask.
                // Somehow breakpoints are ignored if we flash here.
                // see e.g. https://github.com/probe-rs/probe-rs/issues/3991
                "flashingEnabled": false,
                "haltAfterReset": true
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "target/thumbv6m-none-eabi/debug/firmware",
                    "rttEnabled": true,
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            "dataFormat": "Defmt",
                            "logFormat": "{t} {L:5} {s}\n{{m} @ {F}:{l}%dimmed}"
                        }
                    ]
                }
            ],
        },
        {
            "name": "probe-rs attach",
            "type": "probe-rs-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}/software/targets/rp2040",
            "connectUnderReset": false,
            "chip": "RP2040",
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "target/thumbv6m-none-eabi/debug/firmware",
                    "rttEnabled": true,
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            "dataFormat": "Defmt",
                            "logFormat": "{t} {L:5} {s}\n{{m} @ {F}:{l}%dimmed}"
                        }
                    ]
                }
            ],
        }
    ]
}
