// probe-rs has sometimes ignores breakpoints. (Only on rp2040?)
// openocd seems to work better and defmt works aswell.
// The future will tell which one is better. Until then, both are provided as options.

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "probe-rs launch",
            "type": "probe-rs-debug",
            "request": "launch",
            "preLaunchTask": "firmware build",
            "cwd": "${workspaceFolder}/software/targets/rp2040",
            "chip": "RP2040",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": false
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "target/thumbv6m-none-eabi/debug/firmware",
                    "rttEnabled": true,
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            "dataFormat": "Defmt",
                            "logFormat": "{t} {L:5} {s}\n{{m} @ {F}:{l}%dimmed}"
                        }
                    ]
                }
            ],
        },
        {
            "name": "probe-rs attach",
            "type": "probe-rs-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}/software/targets/rp2040",
            "connectUnderReset": false,
            "chip": "RP2040",
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "target/thumbv6m-none-eabi/debug/firmware",
                    "rttEnabled": true,
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            "dataFormat": "Defmt",
                            "logFormat": "{t} {L:5} {s}\n{{m} @ {F}:{l}%dimmed}"
                        }
                    ]
                }
            ],
        },
        {
            "name": "openocd launch",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "openocd pre launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}/software/targets/rp2040",
            "executable": "target/thumbv6m-none-eabi/debug/firmware",
            "device": "RP2040_M0",
            "gdbPath": "gdb-multiarch",
            "configFiles": ["openocd.cfg"],
            // "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "postLaunchCommands": [
                "monitor rtt setup 0x20000000 0x40000 \"SEGGER RTT\"",
                "monitor rtt start",
                "monitor rtt server start 8765 0"
            ],
        }
    ]
}
