{
    "name": "devcontainer",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "settings": {
                "rust-analyzer.completion.autoimport.enable": false,
                "rust-analyzer.inlayHints.typeHints.enable": false,

                "rust-analyzer.linkedProjects": [
                    "software/lib/Cargo.toml",
                    "software/targets/rp2040/Cargo.toml",
                    "features/steps/Cargo.toml"
                ],

                // This is a workaround to suppress "error[E0463]: can't find crate for `test`"
                // It was just annoying during work. Building and testing works fine.
                // see: https://github.com/rust-lang/rust-analyzer/issues/3801
                "rust-analyzer.check.allTargets": false,
                "rust-analyzer.check.extraArgs": [
                    "--target",
                    "thumbv6m-none-eabi"
                ],

                "hediet.vscode-drawio.theme": "kennedy"
            },
            "extensions": [
                "ms-azuretools.vscode-containers",
                "ms-python.python",
                "ybaumes.highlight-trailing-white-spaces",
                "alexkrechik.cucumberautocomplete",
                "rust-lang.rust-analyzer",
                "fill-labs.dependi",
                "tamasfe.even-better-toml",
                "probe-rs.probe-rs-debugger",
                "vadimcn.vscode-lldb"
            ]
        }
    }
}
